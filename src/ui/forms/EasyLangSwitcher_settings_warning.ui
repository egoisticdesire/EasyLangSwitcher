      <item>
       <widget class="QLabel" name="label_warning">
        <property name="text">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body style=&quot;color: rgba(255, 255, 255, 200); margin: 0; padding: 0;&quot;&gt;
&lt;div style=&quot;font-size: 14px;&quot;&gt;
&lt;span style=&quot;color:rgba(255, 255, 255, 225); font-weight:700;&quot;&gt;Warnings:&lt;/span&gt;
&lt;/div&gt;
&lt;ul style=&quot;margin:0; padding:0; list-style:none;&quot;&gt;
&lt;li style=&quot;margin-top:12px;&quot;&gt;
    &lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;
    &lt;tr&gt;
        &lt;td width=&quot;16&quot; valign=&quot;top&quot;&gt;•&lt;/td&gt;
        &lt;td align=&quot;justify&quot; style=&quot;font-size: 12px;&quot;&gt;
            When selecting the
            &lt;code style=&quot;color: rgba(74,144,226,255); font-size:14px;&quot;&gt;Caps&lt;/code&gt;
            &lt;code style=&quot;color: rgba(74,144,226,255); font-size:14px;&quot;&gt;Lock&lt;/code&gt;
            key as a layout switch modifier, its default behavior will change: a short
            press will switch the layout, while repeated or long presses will perform
            the standard action.
        &lt;/td&gt;
    &lt;/tr&gt;
    &lt;/table&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/body&gt;&lt;/html&gt;</string>
        </property>
