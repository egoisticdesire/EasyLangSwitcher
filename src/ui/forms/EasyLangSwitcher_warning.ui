}
QFrame#background_frame QPushButton {
padding: 4px 10px 5px 10px;
border-radius: 8px;
background: rgba(255, 255, 255, 10);
}
QFrame#background_frame QPushButton:hover {
background: rgba(255, 255, 255, 15);
}
QFrame#background_frame QPushButton:pressed {
background: rgba(255, 255, 255, 7);
}
QFrame#background_frame QPushButton:focus {
outline: none;
}
QFrame#background_frame QPushButton#icon_label,
QFrame#background_frame QPushButton#icon_label:hover,
QFrame#background_frame QPushButton#icon_label:pressed,
QFrame#background_frame QPushButton#icon_label:checked,
QFrame#background_frame QPushButton#icon_label:focus {
padding: 0;
background: transparent;
border: 1px solid transparent;
}</string>
